{
  "manifest_version": 3,
  "name": "Focus Browser Activity",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "description": "Share foreground browser activity with Focus and cover blocked sites when protection is on.",
  "key": "",
  "permissions": [
    "tabs",
    "webNavigation",
    "idle",
    "nativeMessaging",
    "storage",
    "alarms",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Focus",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
