<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

  <TextView
      android:id="@+id/wa_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Creating today"
      android:textColor="#8A8A8A"
      android:textSize="11sp" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="bottom"
      android:layout_marginTop="4dp">

    <TextView
        android:id="@+id/wa_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="#FAFAFA"
        android:textSize="30sp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/wa_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0m"
        android:textColor="#8A8A8A"
        android:textSize="11sp" />
  </LinearLayout>

  <ImageView
      android:id="@+id/wa_bar"
      android:layout_width="match_parent"
      android:layout_height="8dp"
      android:layout_marginTop="10dp"
      android:scaleType="fitXY"
      android:contentDescription="Creating vs consuming split" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layout_marginTop="10dp">

    <TextView
        android:id="@+id/wa_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Protected"
        android:textColor="#8A8A8A"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/wa_pause_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_bg"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Pause"
        android:textColor="#FAFAFA"
        android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
