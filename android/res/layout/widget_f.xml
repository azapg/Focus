<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

  <TextView
      android:id="@+id/wf_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Now"
      android:textColor="#8A8A8A"
      android:textSize="11sp" />

  <TextView
      android:id="@+id/wf_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:text="What are you on?"
      android:textColor="#FAFAFA"
      android:textSize="17sp"
      android:fontFamily="sans-serif-medium"
      android:singleLine="true"
      android:ellipsize="end" />

  <ImageView
      android:id="@+id/wf_bar"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:layout_marginTop="10dp"
      android:scaleType="fitXY"
      android:contentDescription="Time used" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layout_marginTop="10dp">

    <TextView
        android:id="@+id/wf_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text=""
        android:textColor="#8A8A8A"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/wf_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_bg"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Set"
        android:textColor="#FAFAFA"
        android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
